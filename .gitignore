# --- dependencies & generated client libs -------------------------------------------------------
node_modules/
# a local npm cache (npm_config_cache=./.npm-cache, npm ci --cache .npm-cache — GitHub #258)
.npm-cache/
# copied from node_modules by tools/vendor.mjs (postinstall); never commit third-party builds
public/vendor/

# --- game assets: (c) Hypergryph / Yostar, fetched or extracted locally, NEVER committed ----------
# tools/fetch-assets.mjs → public/assets/** (~270 MB) and public/fonts/** (+ fonts.css)
public/assets/
public/fonts/
# tools/local-extract/extract.py → public/assets/local/** and this per-machine manifest
# (optional: the client and the tests work without it; docs/DEPLOY.md §6 lists what falls back)
# Battlefield scenes (0.2.5): extracted files live under public/assets/local/scene/ (already ignored by
# public/assets/ above). Downloaded bundles live in .cache/official-scenes/ (already ignored by .cache/ below).
# The repository never stores those official files.
data/local-assets.json
# tools/local-extract/fx.py → the official battle effects' file list (DESIGN §33; the files under public/assets/local/fx/)
data/local-fx.json
# tools/local-extract/skins.py → the installation's own outfits' metadata (the files under public/assets/local/skins/)
data/local-skins.json
# download caches, upstream tables, ledgers, reports, setup state
.cache/
# Per-server published announcements and command data; never shipped with source.
/runtime/
# a worktree that links these folders instead of holding them: git sees a symlink as a file, which the patterns
# above (trailing slash: directories only) do not match
/node_modules
/public/vendor
/public/assets
/public/fonts
/.cache

# --- our own art material: made or collected here, NEVER committed --------------------------------
# The owner's working folders. tools/package.mjs refuses them in a release (its REFUSE list: the
# owner-only notes and the promo project) and .dockerignore already keeps them out of the image;
# screenshots, contact sheets and promo edits in them show official art, so they must not reach
# GitHub either. A path is ignored when it is one of these or lies under one, as in package.mjs.
pv/
review/
handoff/
3，9，11回合情况/
# Art upstream's branch already tracks is unaffected: an ignore rule never applies to a path that is
# in the index, and merging upstream still writes its new files into the worktree and the index
# (public/icons/, docs/img/, test/fixtures/, plugins/_template/cosmetic/media/ keep working as before).
# Working files of the drawing, 3D, video and audio tools: kept on this machine, never a shipped asset.
# Drawing and painting sources
*.psd
*.psb
*.ai
*.xcf
*.kra
*.afdesign
*.afphoto
*.procreate
*.clip
*.sai
*.sai2
*.aseprite
*.ase
# Raster masters the client never serves (it ships png / webp / jpg / svg / ico)
*.tif
*.tiff
*.tga
*.bmp
*.exr
# 3D sources and exports
*.blend
*.blend1
*.fbx
*.obj
*.ztl
*.c4d
*.max
*.ma
*.mb
# Video and its editing projects
*.mp4
*.webm
*.mov
*.mkv
*.flv
*.wmv
*.aep
*.prproj
*.veg
# Audio masters (the client ships .ogg / .mp3)
*.flac
*.aif
*.aiff
*.wav
*.aup

# --- Python (optional local-client extraction) ----------------------------------------------------
.venv*/
venv/
__pycache__/
*.py[cod]

# --- content packs (docs/PACKS.md): the pack index for a static host, generated by `node tools/packs.mjs index`
# (the server answers /packs/index.json itself; tools/package.mjs writes this file into the release zips) -----------
packs/index.json

# --- plugins (docs/PLUGINS.md): a server's own plugins and its policy file live in plugins/ and are never committed;
# only the folder's readme, its guide for AI agents (AGENTS.md) and the templates (plugins/_template/, from P1) are tracked — and
# so ship (tools/package.mjs); plugins/_dist/ (packed zips) and plugins/_moved/ (files the studio moved out) stay ignored
plugins/*
!plugins/README.md
!plugins/AGENTS.md
!plugins/_template/

# --- tests & logs ----------------------------------------------------------------------------------
test/e2e/out/
logs/
*.log

# --- per-machine config (scripts/install-service-windows.ps1) ------------------------------------
scripts/service.env.cmd
.env
.env.*

# --- OS / editor clutter ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
.claude/
# tools/sim-check.mjs: the corpus and its Node traces for /dev/sim-check.html
public/dev/simcheck/data/

# --- private maintenance notes, announcements and one-off investigation artifacts -----------------
# Kept locally. Ignore rules do not remove files from existing commits; publication must audit
# the outgoing commits as well as the final tree, rather than pushing a private working history.
/docs/development/records/
/docs/development/templates/
/docs/release-notes-*.md
/scripts/remote-*.sh
/scripts/notice-*.md
/scripts/sshpass.py
/scripts/verify-cat-hash.py
/scripts/make-unix-bundle.mjs
/tmp-*
/tmp-*/
/public/dev/outfit-probe.html
/public/dev/outfit-probe.js
/public/dev/shop-card-preview.html
/public/dev/skin-flip.html
/public/dev/skin-flip.js
/public/dev/skin-preview.html
/public/dev/skin-preview.js
/tools/unite-perf.mjs
